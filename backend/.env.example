# Clip Studio AI Environment Configuration

# Application Environment (development, production)
ENVIRONMENT=development

# Database Configuration (Leave blank for local SQLite fallback, or provide Supabase PostgreSQL URL)
# Example Supabase URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Secret Key (Generate a random 32-byte hex key in production: openssl rand -hex 32)
JWT_SECRET_KEY=generate-a-secure-random-key-in-production-32bytes-min

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# File Upload Limit in Megabytes (default: 500 MB)
MAX_FILE_SIZE_MB=500

# Core AI Engine Rendering (0 = safe simulation/preview mode, 1 = full local heavy rendering)
ENABLE_HEAVY_RENDERING=0

# Rate Limiting
MAX_LOGIN_ATTEMPTS_PER_MIN=5
MAX_REGISTRATIONS_PER_10MIN=3

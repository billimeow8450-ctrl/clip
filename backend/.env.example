# Clip Studio AI Environment Configuration

# Application Environment (development, production)
ENVIRONMENT=development

# Database Configuration (Leave blank for local SQLite fallback, or provide Supabase PostgreSQL URL)
# Example Supabase URI: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT Secret Key (Generate a random 32-byte hex key in production: openssl rand -hex 32)
JWT_SECRET_KEY=generate-a-secure-random-key-in-production-32bytes-min

# Secret used to sign expiring download URLs (falls back to JWT_SECRET_KEY if unset)
FILE_URL_SECRET=

# Set to 1 ONLY for local development: serves files without ownership checks
ALLOW_PUBLIC_FILE_URLS=0

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Public base URL of the frontend, used in password-reset emails
APP_BASE_URL=http://localhost:5173

# --- Password reset email delivery (CODE_REVIEW.md finding C1) ---
# Preferred: Resend (HTTP API). Get a key at https://dashboard.resend.com/api-keys
# Without a verified domain, Resend can only deliver to the email address that
# owns your Resend account (sandbox sender onboarding@resend.dev).
# Verify your domain in Resend -> Domains, then set EMAIL_FROM e.g.:
#   EMAIL_FROM="Clip Studio <no-reply@yourdomain.com>"
RESEND_API_KEY=
EMAIL_FROM=

# Fallback: classic SMTP (SendGrid, Postmark, SES, Mailgun...). Leave empty
# when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESET_TOKEN_DEBUG_ECHO=1

# --- Uploads & storage (finding C5) ---
MAX_FILE_SIZE_MB=500
MAX_TOTAL_STORAGE_PER_USER_MB=2048
MAX_FILES_PER_USER=50
OUTPUT_RETENTION_HOURS=24

# --- Job processing (finding M4) ---
MAX_CONCURRENT_JOBS=2

# Core AI Engine Rendering (0 = safe simulation/preview mode, 1 = full local heavy rendering)
ENABLE_HEAVY_RENDERING=0

# Rate Limiting
MAX_LOGIN_ATTEMPTS_PER_MIN=5
MAX_REGISTRATIONS_PER_10MIN=3
# Number of trusted proxy hops in front of the API (Render = 1).
# Leave empty for direct local access.
TRUSTED_PROXY_COUNT=
